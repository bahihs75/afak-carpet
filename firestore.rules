rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validStatus() {
      return request.resource.data.status in [
        'new', 'pending', 'processing', 'contacted', 'completed', 'cancelled'
      ];
    }

    match /content/{docId} {
      allow read: if true;
      // The admin UI requires Firebase Authentication; the public site cannot write content.
      allow write: if signedIn();
    }

    match /orders/{orderId} {
      // There is no SQL database here. These rules validate the Firestore document shape,
      // size limits, and fixed status field; XSS is also prevented by escaped rendering.
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'category', 'wilayaCode', 'wilayaName', 'commune',
          'message', 'product', 'status', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8 &&
        request.resource.data.phone.size() <= 20 &&
        request.resource.data.category in ['mosques', 'hotels', 'schools', 'halls'] &&
        request.resource.data.wilayaCode is string &&
        request.resource.data.wilayaCode.size() > 0 &&
        request.resource.data.wilayaCode.size() <= 10 &&
        request.resource.data.wilayaName is string &&
        request.resource.data.wilayaName.size() <= 100 &&
        request.resource.data.commune is string &&
        request.resource.data.commune.size() <= 100 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time &&
        (!request.resource.data.keys().hasAny(['product']) || request.resource.data.product == null || request.resource.data.product is map);

      allow read, delete: if signedIn();
      // Admin status changes cannot alter customer data or inject extra fields.
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        validStatus();
    }
  }
}
