rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Site content (hero, categories, products, settings, about):
    // anyone can read (public website), only a signed-in admin can write.
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders (quote requests): anyone can create one (the public quote
    // form), nobody can read/update/delete except a signed-in admin —
    // this protects customer phone numbers from being scraped publicly.
    //
    // The `create` rule below is deliberately strict: it re-validates every
    // field's type and length server-side so a malicious or malformed
    // request (a scripted bot spamming huge payloads, unexpected extra
    // fields, etc.) is rejected before it ever reaches the database. This
    // is the NoSQL equivalent of parameterized queries / input validation —
    // there is no SQL database here so classic "SQL injection" doesn't
    // apply, but unvalidated writes are the real-world equivalent risk for
    // a database like this one, and this closes that door.
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read, update, delete: if request.auth != null;
    }

    function isValidOrder(o){
      return o.keys().hasOnly(['name','phone','category','wilayaCode','wilayaName','commune','message','product','status','createdAt'])
        && o.name is string && o.name.size() > 0 && o.name.size() < 100
        && o.phone is string && o.phone.size() > 0 && o.phone.size() < 30
        && o.category is string && o.category.size() < 50
        && (!('message' in o) || (o.message is string && o.message.size() < 1000))
        && o.status == 'new';
    }
  }
}
